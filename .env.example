# Copy to .env in the repository root, fill it in, and only then run
# <provider>/deploy.sh:
#   cp .env.example .env
# Each deploy.sh reads the shared settings and its own provider block only,
# so the settings of providers you do not use can stay as they are.

# --- Shared

# User that rclone, the scripts and the systemd units run as (not root)
RUN_USER=rclone_user

# Disk mount point (checked before each run, used for RequiresMountsFor)
MOUNT_POINT=/mnt/storage

# Where deploy.sh installs the providers: <APP_DIR>/<provider>-pull/
# holds the script, a generated .env, .lock and log/
APP_DIR=/home/rclone_user

# --- Google Drive (gdrive/deploy.sh)

# Source: remote from rclone.conf and a folder on it
GDRIVE_SRC_REMOTE=gdrive:SomeDir

# Destination on the local disk (inside MOUNT_POINT)
GDRIVE_DST_DIR=/mnt/storage/gdrive

# --- iCloud Drive (icloud/deploy.sh)

# Source: remote from rclone.conf and a folder on it
# (for iCloud Photos use a remote created with service=photos, e.g. icloudphotos:PrimarySync/Favorites)
ICLOUD_SRC_REMOTE=icloud:SomeDir

# Destination on the local disk (inside MOUNT_POINT)
ICLOUD_DST_DIR=/mnt/storage/icloud
