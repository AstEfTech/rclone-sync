# Скопируйте в .env, заполните и только потом запускайте deploy.sh:
#   cp .env.example .env

# Пользователь, под которым работают rclone, скрипт и systemd-юнит (не root)
RUN_USER=rclone_user

# Источник: remote из rclone.conf и папка на нём
SRC_REMOTE=gdrive:SomeDir

# Приёмник на локальном диске
DST_DIR=/mnt/storage/dest

# Точка монтирования диска (проверяется перед запуском, нужна для RequiresMountsFor)
MOUNT_POINT=/mnt/storage

# Куда deploy.sh ставит скрипты; здесь же будут .env, .lock и log/
APP_DIR=/home/rclone_user/gdrive-pull
