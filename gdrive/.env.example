# Copy to .env, fill it in, and only then run deploy.sh:
#   cp .env.example .env

# User that rclone, the script and the systemd unit run as (not root)
RUN_USER=rclone_user

# Source: remote from rclone.conf and a folder on it
SRC_REMOTE=gdrive:SomeDir

# Destination on the local disk
DST_DIR=/mnt/storage/dest

# Disk mount point (checked before each run, used for RequiresMountsFor)
MOUNT_POINT=/mnt/storage

# Where deploy.sh installs the scripts; .env, .lock and log/ live here too
APP_DIR=/home/rclone_user/gdrive-pull
